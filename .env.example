# ==============================================================================
# RefPromos - Environment Configuration Template (.env.example)
# ==============================================================================
# COPY THIS FILE TO `.env` AND FILL IN YOUR SECRETS.
# DO NOT COMMIT `.env` OR ANY REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - TLS/SSL Required):
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptography (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify Admin session JWTs (Minimum 32 characters).
# Generate via: openssl rand -base64 48
JWT_SECRET="generate-a-secure-random-64-character-secret-key-here"

# Salt string used for one-way SHA-256 IP address anonymization in click logs.
# Generate via: openssl rand -hex 32
IP_SALT="generate-a-secure-random-salt-here"

# ------------------------------------------------------------------------------
# 3. Super Admin Initial Seed Credentials (Used only during `npm run db:seed`)
# ------------------------------------------------------------------------------
# Initial super admin credentials created during database seeding.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!#"

# ------------------------------------------------------------------------------
# 4. Public Site Settings (Client-safe - exposed to browser)
# ------------------------------------------------------------------------------
# Public canonical domain of the application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
